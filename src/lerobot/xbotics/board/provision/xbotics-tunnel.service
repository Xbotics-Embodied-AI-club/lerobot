[Unit]
Description=Xbotics kit: SSH tunnel that maps server ports (inference, TensorBoard) onto the board's 0.0.0.0
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
ExecStart=/usr/bin/python3 /opt/xbotics/provision/xbotics_tunnel.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
